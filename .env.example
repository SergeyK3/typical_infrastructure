# Typical infrastructure MVP — environment template
# Copy to .env and fill values. Never commit .env to git.

# Application
APP_NAME=Typical infrastructure

# Database (SQLite path; for Docker use /app/data/app.db)
SQLITE_PATH=app.db
SKILL_ASSESSMENT_DATA_DIR=data

# Optional: port for docker-compose
APP_PORT=8000

# Optional HR skill assessment / attestations module
# Copy real secrets only to .env, never commit them.
TELEGRAM_ENABLE_POLLING=0
TELEGRAM_POLLING_RUN_IN_UVICORN=0
TELEGRAM_BOT_TOKEN=1234567890:AA-REPLACE-WITH-TOKEN-FROM-BOTFATHER
TELEGRAM_DOCS_SURVEY_FALLBACK_CHAT_ID=123456789
TELEGRAM_DOCS_SURVEY_HR_NOTIFY_CHAT_ID=123456789
TELEGRAM_EXAM_PROTOCOL_CHANNEL_ID=123456789
TELEGRAM_EXAM_MANAGER_CHAT_ID=123456789
SKILL_ASSESSMENT_PUBLIC_BASE_URL=http://127.0.0.1:8000
SKILL_ASSESSMENT_HR_BASE_URL=http://127.0.0.1:8000
DOCS_SURVEY_LOCAL_TIMEZONE=Asia/Almaty
