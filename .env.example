# Typical infrastructure MVP — environment template
# Copy to .env and fill values. Never commit .env to git.

# Application
APP_NAME=Typical infrastructure

# Database (SQLite path; for Docker use /app/data/app.db)
SQLITE_PATH=app.db

# Optional: port for docker-compose
APP_PORT=8000

# Optional HR skill assessment / attestations module
# Copy real secrets only to .env, never commit them.
TELEGRAM_ENABLE_POLLING=0
TELEGRAM_POLLING_RUN_IN_UVICORN=0
TELEGRAM_BOT_TOKEN=1234567890:AA-REPLACE-WITH-TOKEN-FROM-BOTFATHER
TELEGRAM_DOCS_SURVEY_FALLBACK_CHAT_ID=123456789
TELEGRAM_DOCS_SURVEY_HR_NOTIFY_CHAT_ID=123456789
TELEGRAM_EXAM_PROTOCOL_CHANNEL_ID=123456789
TELEGRAM_EXAM_MANAGER_CHAT_ID=123456789
SKILL_ASSESSMENT_PUBLIC_BASE_URL=http://127.0.0.1:8000
SKILL_ASSESSMENT_HR_BASE_URL=http://127.0.0.1:8000
DOCS_SURVEY_LOCAL_TIMEZONE=Asia/Almaty

# Psychological testing Telegram worker (python -m psychological_testing.telegram_worker)
# Token: copy from 07 PsychTest/.env BOT_TOKEN → TELEGRAM_BOT_TOKEN here
PSYCH_TESTING_ENABLE_POLLING=0
PSYCH_TESTING_TELEGRAM_OUTBOUND=http
# PSYCH_TESTING_STT_PROVIDER=mock
# mbti_dialog (голос): PSYCH_TESTING_STT_PROVIDER=openai + ключ OpenAI
# PSYCH_TESTING_OPENAI_API_KEY=   # или OPENAI_API_KEY / SKILL_ASSESSMENT_OPENAI_API_KEY
# PSYCH_TESTING_DEV_CLIENT_ID=dev-client
# PSYCH_TESTING_DEV_EMPLOYEE_ID=dev-employee
# Phase 3b: save canonical JSON on session complete (data/sessions/v1/YYYY-MM-DD/)
# PSYCH_TESTING_PERSIST_JSON=1
# PSYCH_TESTING_SESSIONS_DIR=psychological_testing/data/sessions/v1
# PSYCH_TESTING_MBTI_QUESTIONS_PER_AXIS=1
# MBTI delivery: structured (default, A/B buttons) | dialog (Akma + LLM, backup UX)
# PSYCH_TESTING_MBTI_DELIVERY_MODE=structured
# PSYCH_TESTING_MBTI_DIALOG_MAX_QUESTIONS=12
# Dialog mode: voice-first (Whisper). Text fallback only when STT=mock (dev).
# PSYCH_TESTING_MBTI_DIALOG_VOICE_PRIMARY=1
# PSYCH_TESTING_MBTI_DIALOG_ALLOW_TEXT=0
# PSYCH_TESTING_AI_ENABLED=0
# PSYCH_TESTING_AI_PROVIDER=mock
# PSYCH_TESTING_AI_MODEL=gpt-4o-mini
# PSYCH_TESTING_AI_MODEL_AKMA=gpt-4o-mini
# PSYCH_TESTING_AI_MODEL_EVAL=gpt-4o-mini
# PSYCH_TESTING_AI_MODEL_REPORT=gpt-4o-mini
# PSYCH_TESTING_AI_BASE_URL=https://api.openai.com/v1
# PDF export cache (local): hash | on | off
# PSYCH_TESTING_PDF_CACHE=hash
# PSYCH_TESTING_PDF_AI=1
# PSYCH_TESTING_RBAC_EXPORT=0
# Google Drive (service account; folder shared with SA email)
# PSYCH_TESTING_GDRIVE=0
# PSYCH_TESTING_GDRIVE_FOLDER_ID=
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=secrets/psych-testing-sa.json
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON_INLINE=
# PSYCH_TESTING_GDRIVE_UPLOAD_MANIFEST=1
# PSYCH_TESTING_GDRIVE_UPLOAD_SESSIONS=0
